        "url": "http://host.docker.internal:8000/review-queue",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "75672416-8939-4ac6-b5b0-7892564af005",
      "name": "Resumen de ejecución",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const casos = $input.all().map(item => item.json);\nconst nuevos = casos.filter(caso => caso.nuevo).length;\nreturn [{ json: {\n  procesados: casos.length,\n  nuevos,\n  existentes: casos.length - nuevos,\n  pendientes: casos.filter(caso => caso.estado === 'pendiente').length,\n  casos,\n} }];"
      }
    }
