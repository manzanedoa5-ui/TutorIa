      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(({ json }) => {\n  const { id, semestre, riesgo_estimado } = json.casos ?? json;\n  return { json: { id, semestre, riesgo_estimado } };\n});"
      }
